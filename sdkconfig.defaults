# Committed configuration; `sdkconfig` is generated and not committed.

CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash, stock X4 Pro partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Stock bootloader has rollback enabled; keep ours the same.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Console (logs + command line) on the native USB Serial/JTAG port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# C++ without exceptions or RTTI.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# BLE: NimBLE host, peripheral only, one connection, bonds kept in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=8
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_EXT_ADV=n
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="ESP32 Auth"
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# LVGL (components/ui): 1-bit colour for the X4 Pro e-ink (monochrome theme);
# every LVGL allocation (widgets, layers, draw buffers) in PSRAM through
# components/ui/lv_mem_psram.c instead of a static pool in internal RAM; libc
# string and printf.
CONFIG_LV_COLOR_DEPTH_1=y
# Redraw at most every 200 ms: e-ink takes hundreds of ms per (partial) update.
CONFIG_LV_DEF_REFR_PERIOD=200
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# 480x800 at ~220 dpi: 14 px (the default font) is small; 20, 24, 28 and 32 as well.
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
# The BLE passkey on the pairing page.
CONFIG_LV_FONT_MONTSERRAT_48=y
# The web site's address as a QR code (Settings > Web site).
CONFIG_LV_USE_QRCODE=y
# PNG decoder for the power-off wallpapers (/sdcard/wallpapers).
CONFIG_LV_USE_LODEPNG=y

# FAT long file names in UTF-8: the microSD card holds books named in any script.
CONFIG_FATFS_API_ENCODING_UTF_8=y
